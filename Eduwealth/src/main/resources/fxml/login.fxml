<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- CU-02: Autenticar usuario -->
<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.eduwealth.controller.LoginController">

    <fx:include source="auth-hero.fxml"/>

    <StackPane HBox.hgrow="ALWAYS" styleClass="auth-zona-formulario">
        <VBox styleClass="tarjeta" maxWidth="420" maxHeight="-Infinity">
            <Label text="Iniciar sesión" styleClass="titulo"/>
            <Label text="Accede a tu espacio financiero." styleClass="subtitulo"/>

            <Label text="Correo electrónico" styleClass="etiqueta-campo"/>
            <TextField fx:id="campoEmail" promptText="tu@correo.com"/>

            <Label text="Contraseña" styleClass="etiqueta-campo"/>
            <PasswordField fx:id="campoPassword" promptText="••••••••"/>

            <Label fx:id="mensajeError" styleClass="mensaje-error" visible="false" managed="false"/>

            <Button text="Entrar" styleClass="boton-primario" defaultButton="true"
                    maxWidth="Infinity" onAction="#entrar"/>

            <HBox spacing="4" alignment="CENTER">
                <Label text="¿No tienes cuenta?" styleClass="nota"/>
                <Hyperlink text="Regístrate" onAction="#irARegistro"/>
            </HBox>

            <Label text="Cuenta de prueba: demo@eduwealth.com · demo1234" styleClass="nota"/>
        </VBox>
    </StackPane>
</HBox>
