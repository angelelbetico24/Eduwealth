<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- CU-01: Registrar usuario -->
<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.eduwealth.controller.RegistroController">

    <fx:include source="auth-hero.fxml"/>

    <StackPane HBox.hgrow="ALWAYS" styleClass="auth-zona-formulario">
        <VBox styleClass="tarjeta" maxWidth="440" maxHeight="-Infinity" spacing="10">
            <Label text="Crear cuenta" styleClass="titulo"/>
            <Label text="Empieza a practicar con 10.000 de saldo virtual en tu moneda." styleClass="subtitulo"/>

            <Label text="Nombre completo" styleClass="etiqueta-campo"/>
            <TextField fx:id="campoNombre" promptText="Tu nombre"/>

            <Label text="Correo electrónico" styleClass="etiqueta-campo"/>
            <TextField fx:id="campoEmail" promptText="tu@correo.com"/>

            <Label text="Moneda principal de referencia" styleClass="etiqueta-campo"/>
            <ComboBox fx:id="comboDivisa" promptText="Selecciona una divisa" maxWidth="Infinity"/>

            <HBox spacing="12">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Contraseña" styleClass="etiqueta-campo"/>
                    <PasswordField fx:id="campoPassword" promptText="Mínimo 8 caracteres"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Repite la contraseña" styleClass="etiqueta-campo"/>
                    <PasswordField fx:id="campoConfirmacion" promptText="••••••••"/>
                </VBox>
            </HBox>

            <Label fx:id="mensajeError" styleClass="mensaje-error" visible="false" managed="false"/>

            <Button text="Crear cuenta" styleClass="boton-primario" defaultButton="true"
                    maxWidth="Infinity" onAction="#registrar"/>

            <HBox spacing="4" alignment="CENTER">
                <Label text="¿Ya tienes cuenta?" styleClass="nota"/>
                <Hyperlink text="Inicia sesión" onAction="#irALogin"/>
            </HBox>
        </VBox>
    </StackPane>
</HBox>
