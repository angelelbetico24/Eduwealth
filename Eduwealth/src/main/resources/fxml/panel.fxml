<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Panel provisional tras iniciar sesión: se sustituirá por el Panel Principal con menú lateral -->
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.eduwealth.controller.PanelController">
    <VBox styleClass="tarjeta" maxWidth="460" maxHeight="-Infinity">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label fx:id="saludo" styleClass="titulo"/>
            <Label fx:id="rol" styleClass="chip"/>
        </HBox>
        <Label fx:id="email" styleClass="subtitulo"/>
        <Label text="Saldo virtual disponible" styleClass="etiqueta-campo"/>
        <Label fx:id="saldo" styleClass="saldo"/>
        <Label text="El resto de módulos (simulador, presupuestos, educación y brokers) se añadirán en las siguientes versiones."
               styleClass="nota"/>
        <Button text="Cerrar sesión" styleClass="boton-secundario" onAction="#cerrarSesion"/>
    </VBox>
</StackPane>
