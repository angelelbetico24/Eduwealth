<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- CU-08: Realizar lección y test (lectura → test → resultado) -->
<ScrollPane fx:id="desplazamiento" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.eduwealth.controller.LeccionController"
            fitToWidth="true" styleClass="scroll-contenido">

    <VBox styleClass="pagina">

        <!-- Cabecera común -->
        <Hyperlink text="←  Volver a la ruta de aprendizaje" onAction="#volver"/>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <VBox spacing="6">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label fx:id="chipNivel" styleClass="chip"/>
                    <Label fx:id="datosLeccion" styleClass="nota"/>
                </HBox>
                <Label fx:id="tituloLeccion" styleClass="titulo" wrapText="true"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="chipFase" styleClass="chip-gris"/>
        </HBox>

        <Label fx:id="avisoError" styleClass="mensaje-error" wrapText="true" visible="false" managed="false"/>

        <!-- Fase 1: lectura -->
        <VBox fx:id="faseLectura" spacing="20">
            <VBox fx:id="contenidoLeccion" styleClass="tarjeta-panel, tarjeta-lectura" spacing="14"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Cuando termines de leer, comprueba lo que has aprendido." styleClass="nota"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="botonIniciarTest" text="Iniciar test de evaluación  →" styleClass="boton-primario"
                        minWidth="-Infinity" onAction="#iniciarTest"/>
            </HBox>
        </VBox>

        <!-- Fase 2: test -->
        <VBox fx:id="faseTest" spacing="16" visible="false" managed="false">
            <HBox styleClass="tarjeta-panel" spacing="14" alignment="CENTER_LEFT">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="Test de evaluación" styleClass="tarjeta-titulo"/>
                    <Label text="Elige una respuesta en cada pregunta. Necesitas un 70 % de aciertos para superar la lección."
                           styleClass="nota" wrapText="true"/>
                </VBox>
                <VBox spacing="6" alignment="CENTER_RIGHT" minWidth="200">
                    <Label fx:id="contadorRespuestas" styleClass="tarjeta-subtitulo"/>
                    <ProgressBar fx:id="barraRespuestas" prefWidth="200" styleClass="barra, barra-azul"/>
                </VBox>
            </HBox>
            <VBox fx:id="listaPreguntas" spacing="14"/>
            <Label fx:id="mensajeTest" styleClass="mensaje-error" wrapText="true" visible="false" managed="false"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button text="Volver a la lección" styleClass="boton-secundario" onAction="#volverALectura"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="botonEnviar" text="Enviar respuestas" styleClass="boton-primario"
                        minWidth="-Infinity" onAction="#enviarTest"/>
            </HBox>
        </VBox>

        <!-- Fase 3: resultado -->
        <VBox fx:id="faseResultado" spacing="16" visible="false" managed="false">
            <VBox fx:id="tarjetaResultado" styleClass="tarjeta-panel, tarjeta-resultado" spacing="10"/>
            <Label text="Corrección" styleClass="tarjeta-titulo"/>
            <VBox fx:id="listaCorrecciones" spacing="10"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button text="Repasar la lección" styleClass="boton-secundario" onAction="#volverALectura"/>
                <Button fx:id="botonReintentar" text="Reintentar el test" styleClass="boton-secundario"
                        onAction="#iniciarTest"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Volver a la ruta de aprendizaje" styleClass="boton-primario" minWidth="-Infinity"
                        onAction="#volver"/>
            </HBox>
        </VBox>

        <Label text="ⓘ Contenido educativo, no asesoramiento financiero. Invertir conlleva riesgos." styleClass="nota"/>
    </VBox>
</ScrollPane>
